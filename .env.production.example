# ==============================================================================
# CyberShield Production Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS INTO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=False
PROJECT_NAME="CyberShield Security Operations Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Generate with: openssl rand -hex 32 (Must be at least 32 characters)
SECRET_KEY=GENERATE_HIGH_ENTROPY_PRODUCTION_SECRET_KEY_MIN_32_CHARS

# Whitelist exact production domain origins (comma-separated, NO trailing slashes, NO localhost)
ALLOWED_ORIGINS=https://app.cybershield.io,https://soc.cybershield.io

# ------------------------------------------------------------------------------
# 2. SUPABASE PRODUCTION CLUSTER & AUTH
# ------------------------------------------------------------------------------
SUPABASE_URL=https://[YOUR_PROD_PROJECT_ID].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Raw JWT secret from Supabase Dashboard -> Project Settings -> API -> JWT Settings
SUPABASE_JWT_SECRET=GENERATE_OR_COPY_FROM_SUPABASE_PROJECT_SETTINGS
SUPABASE_JWT_ALGORITHM=HS256

# WARNING: NEVER expose SUPABASE_SERVICE_ROLE_KEY to frontend code or client devices
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 3. REDIS BROKER & CELERY WORKER POOL
# ------------------------------------------------------------------------------
REDIS_PASSWORD=GENERATE_STRONG_REDIS_PASSWORD_MIN_24_CHARS
REDIS_URL=redis://:${REDIS_PASSWORD}@cybershield-redis-prod:6379/0
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@cybershield-redis-prod:6379/0
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@cybershield-redis-prod:6379/1

# ------------------------------------------------------------------------------
# 4. APPLICATION SECURITY & RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=True
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_BURST_ALLOWANCE=20

SECURITY_HEADERS_ENABLED=True
MAX_REQUEST_SIZE_BYTES=26214400 # 25 MB max body size

# ------------------------------------------------------------------------------
# 5. FRONTEND NEXT.JS WEB APP (Public variables safe for browser exposure)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.cybershield.io
NEXT_PUBLIC_API_URL=https://api.cybershield.io/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR_PROD_PROJECT_ID].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 6. EXTERNAL INTEL & OBSERVABILITY
# ------------------------------------------------------------------------------
NVD_API_KEY=YOUR_NATIONAL_VULNERABILITY_DATABASE_API_KEY
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.corp.internal:4317
