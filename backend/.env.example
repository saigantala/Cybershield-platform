# CyberShield FastAPI Backend Configuration
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="CyberShield Security API"
API_V1_STR=/api/v1
SECRET_KEY=cybershield-dev-secret-key-change-in-production-min-32-chars

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Supabase PostgreSQL & Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Optional JWT Secret for HS256 validation (or set to empty to verify via JWKS)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-if-using-hs256
SUPABASE_JWT_ALGORITHM=HS256

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Scanner Guardrails
SCAN_DEFAULT_TIMEOUT_SECONDS=1800
SCAN_MAX_CONCURRENCY_PER_ORG=2

# Sprint 6: Vulnerability Scanner & Intel Integrations
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
KEV_CATALOG_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# Greenbone / OpenVAS Scanner Integration
OPENVAS_HOST=localhost
OPENVAS_PORT=9390
OPENVAS_USERNAME=admin
OPENVAS_PASSWORD=

# OWASP ZAP Safe Baseline Scanner Integration
ZAP_API_URL=http://localhost:8080
ZAP_API_KEY=
