# ==============================================================================
# CyberShield Security Platform Environment Configuration
# ==============================================================================

# NEXT.JS WEB APP
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# SUPABASE POSTGRESQL & AUTH
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# FASTAPI CENTRAL BACKEND
FASTAPI_SECRET_KEY=change-this-to-a-very-long-and-secure-random-secret
FASTAPI_DEBUG=True
FASTAPI_ALLOWED_ORIGINS=http://localhost:3000,https://app.cybershield.internal

# BACKGROUND WORKERS (CELERY + REDIS)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# SCANNER ENGINE ISOLATION
OPENVAS_GMP_HOST=localhost
OPENVAS_GMP_PORT=9390
OPENVAS_USER=admin
OPENVAS_PASSWORD=admin-openvas-secret
ZAP_ENDPOINT=http://localhost:8080
ZAP_API_KEY=zap-super-secret-key

# THREAT INTELLIGENCE
CISA_KEV_FEED_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
NVD_API_KEY=

# COMMUNICATIONS & NOTIFICATIONS
RESEND_API_KEY=re_your_resend_api_key
EXPO_ACCESS_TOKEN=your_expo_push_access_token
