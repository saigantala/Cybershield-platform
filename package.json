{
  "name": "cybershield-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "CyberShield – Intelligent Network Security Monitoring & Vulnerability Assessment Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
